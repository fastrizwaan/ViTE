{
    "name": "Default Light",
    "type": "light",
    "colors": {
        "editor.background": "#ffffff",
        "editor.foreground": "#383a42",
        "editorGutter.background": "#ffffff",
        "editorLineNumber.foreground": "#9d9d9f",
        "editorLineNumber.activeForeground": "#383a42",
        "editor.lineHighlightBackground": "#383a4208",
        "editor.selectionBackground": "#bfceff",
        "editorCursor.foreground": "#383a42",
        "editorOverviewRuler.findMatchForeground": "#c1840180",
        "editor.findMatchBackground": "#c1840140",
        "editor.findMatchHighlightBackground": "#c1840120",
        "tab.activeBackground": "#ffffff",
        "tab.activeForeground": "#383a42",
        "tab.inactiveBackground": "#f0f0f0",
        "tab.inactiveForeground": "#9d9d9f",
        "tab.border": "#e5e5e6",
        "titleBar.activeBackground": "#f0f0f0",
        "titleBar.activeForeground": "#383a42",
        "statusBar.background": "#f0f0f0",
        "statusBar.foreground": "#383a42",
        "scrollbarSlider.background": "#4e566640",
        "scrollbarSlider.hoverBackground": "#4e566660",
        "scrollbarSlider.activeBackground": "#4e566680"
    },
    "tokenColors": [
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#a626a4"
            }
        },
        {
            "name": "Built-in / Support",
            "scope": [
                "support.function",
                "support.class",
                "support.type"
            ],
            "settings": {
                "foreground": "#0184bc"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted"
            ],
            "settings": {
                "foreground": "#50a14f"
            }
        },
        {
            "name": "Comments",
            "scope": [
                "comment",
                "comment.line",
                "comment.block"
            ],
            "settings": {
                "foreground": "#5c6370"
            }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#986801"
            }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call"
            ],
            "settings": {
                "foreground": "#4078f2"
            }
        },
        {
            "name": "Types / Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type"
            ],
            "settings": {
                "foreground": "#c18401"
            }
        },
        {
            "name": "Decorators",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": {
                "foreground": "#a626a4"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other"
            ],
            "settings": {
                "foreground": "#e45649"
            }
        },
        {
            "name": "Plain text / Variable C",
            "scope": [
                "variable.other.readwrite",
                "meta.object-literal.key"
            ],
            "settings": {
                "foreground": "#383a42"
            }
        },
        {
            "name": "Constants / Macros",
            "scope": [
                "constant",
                "constant.language",
                "variable.other.constant",
                "entity.name.constant"
            ],
            "settings": {
                "foreground": "#e45649"
            }
        },
        {
            "name": "Tags (HTML/XML)",
            "scope": [
                "entity.name.tag"
            ],
            "settings": {
                "foreground": "#e45649"
            }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator"
            ],
            "settings": {
                "foreground": "#986801"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator"
            ],
            "settings": {
                "foreground": "#986801"
            }
        },
        {
            "name": "Attributes",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#986801"
            }
        },
        {
            "name": "Parameters",
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#e45649"
            }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "support.variable.property"
            ],
            "settings": {
                "foreground": "#0184bc"
            }
        },
        {
            "name": "Preprocessor",
            "scope": [
                "meta.preprocessor",
                "keyword.control.directive"
            ],
            "settings": {
                "foreground": "#a626a4"
            }
        },
        {
            "name": "Logical operators",
            "scope": [
                "keyword.operator.logical",
                "keyword.operator.comparison"
            ],
            "settings": {
                "foreground": "#0184bc"
            }
        }
    ]
}