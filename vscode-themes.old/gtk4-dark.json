{
    "name": "Gnome One Dark",
    "type": "dark",
    "colors": {
        "editor.background": "#1d1d20",
        "editor.foreground": "#d1d1d1",
        "editorGutter.background": "#1d1d20",
        "editorLineNumber.foreground": "#6b6b6b",
        "editorLineNumber.activeForeground": "#d1d1d1",
        "editor.lineHighlightBackground": "#d1d1d10a",
        "editor.selectionBackground": "#3e4451",
        "editorCursor.foreground": "#d1d1d1",
        "editorOverviewRuler.findMatchForeground": "#e5c07b80",
        "editor.findMatchBackground": "#e5c07b40",
        "editor.findMatchHighlightBackground": "#e5c07b20",
        "tab.activeBackground": "#282c34",
        "tab.activeForeground": "#d1d1d1",
        "tab.inactiveBackground": "#1d1d20",
        "tab.inactiveForeground": "#6b6b6b",
        "tab.border": "#181a1f",
        "titleBar.activeBackground": "#21252b",
        "titleBar.activeForeground": "#d1d1d1",
        "statusBar.background": "#21252b",
        "statusBar.foreground": "#d1d1d1",
        "scrollbarSlider.background": "#4e566680",
        "scrollbarSlider.hoverBackground": "#5a637580",
        "scrollbarSlider.activeBackground": "#747d9180"
    },
    "tokenColors": [
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#c678dd"
            }
        },
        {
            "name": "Built-in / Support",
            "scope": [
                "support.function",
                "support.class",
                "support.type"
            ],
            "settings": {
                "foreground": "#56b6c2"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted"
            ],
            "settings": {
                "foreground": "#98c379"
            }
        },
        {
            "name": "Comments",
            "scope": [
                "comment",
                "comment.line",
                "comment.block"
            ],
            "settings": {
                "foreground": "#7f848e"
            }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#d19a66"
            }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call"
            ],
            "settings": {
                "foreground": "#61afef"
            }
        },
        {
            "name": "Types / Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type"
            ],
            "settings": {
                "foreground": "#e5c07b"
            }
        },
        {
            "name": "Decorators",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": {
                "foreground": "#56b6c2"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other"
            ],
            "settings": {
                "foreground": "#e06c75"
            }
        },
        {
            "name": "Plain text / Variable C",
            "scope": [
                "variable.other.readwrite",
                "meta.object-literal.key"
            ],
            "settings": {
                "foreground": "#d1d1d1"
            }
        },
        {
            "name": "Constants / Macros",
            "scope": [
                "constant",
                "constant.language",
                "variable.other.constant",
                "entity.name.constant"
            ],
            "settings": {
                "foreground": "#e06c75"
            }
        },
        {
            "name": "Tags (HTML/XML)",
            "scope": [
                "entity.name.tag"
            ],
            "settings": {
                "foreground": "#e06c75"
            }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator"
            ],
            "settings": {
                "foreground": "#d19a66"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator"
            ],
            "settings": {
                "foreground": "#d19a66"
            }
        },
        {
            "name": "Attributes",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#d19a66"
            }
        },
        {
            "name": "Parameters",
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#e06c75"
            }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "support.variable.property"
            ],
            "settings": {
                "foreground": "#56b6c2"
            }
        },
        {
            "name": "Preprocessor",
            "scope": [
                "meta.preprocessor",
                "keyword.control.directive"
            ],
            "settings": {
                "foreground": "#c678dd"
            }
        },
        {
            "name": "Logical operators",
            "scope": [
                "keyword.operator.logical",
                "keyword.operator.comparison"
            ],
            "settings": {
                "foreground": "#56b6c2"
            }
        }
    ]
}